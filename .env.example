# Shared base URL for all Synapse backend requests. Copy this file to
# .env.local to override it. The application uses this local URL when unset.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Account access follows build mode: Vite development keeps the local profile;
# built previews and packaged apps require sign-in. The backend must match:
# SYNAPSE_LOCAL_PROFILE_COMPAT=1 for development, 0 for normal use.

# Mock intervention data and generated sample audio are strictly opt-in.
# Keep false for local backend integration. Q&A and quiz always use the backend.
VITE_API_MOCK_MODE=false

# Temporary Structured View demonstration only. The rest of the frontend keeps
# using the real backend. Real structured.rows always take precedence.
VITE_STRUCTURED_VIEW_DEMO=false

# First-launch Welcome screen. Explicit 1/true enables it; 0/false disables it.
# When unset, it is enabled outside tests and disabled in the test runner.
# Vite writes this value into the bundle at build time.
# VITE_ONBOARDING_ENABLED=

# Global frontend Voice Control. Explicit 1/true enables it; 0/false disables it.
# When unset, it is enabled in development and disabled in production and tests.
# Vite writes this value into the bundle at build time.
# VITE_VOICE_CONTROL_ENABLED=
