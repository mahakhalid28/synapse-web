# Shared base URL for all Synapse backend requests. Copy this file to
# .env.local to override it. The application uses this local URL when unset.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Mock intervention data and generated sample audio are strictly opt-in.
# Keep false for local backend integration. Q&A and quiz always use the backend.
VITE_API_MOCK_MODE=false

# Welcome screen and first-lecture guidance. On by default in development and in a
# production build; off in the test runner. Set to 0 or false to turn it off, or
# 1 or true to force it on. Vite writes this into the bundle at build time, so a
# packaged app cannot change it afterwards.
# VITE_ONBOARDING_ENABLED=
