# Shared base URL for all Synapse backend requests. Copy this file to
# .env.local to override it. The application uses this local URL when unset.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Mock intervention data and generated sample audio are strictly opt-in.
# Keep false for local backend integration. Q&A and quiz always use the backend.
VITE_API_MOCK_MODE=false

# Voice control (docs/voice-control.md). Unset: on in development, off in a production build and in tests.
# Set to true or 1 to force it on, anything else to force it off.
# VITE_VOICE_CONTROL_ENABLED=true
